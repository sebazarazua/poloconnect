# CONFIGURACION GENERAL
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
TRUST_PROXY=false
# Public HTTPS origin of this deployed API (e.g. https://poloconnect-production.up.railway.app).
# Not secret, but must be a real internet-reachable URL. Used to build the Mercado Pago webhook notification_url.
PUBLIC_BASE_URL=

# DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# AUTH
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# CORS
# Comma-separated browser origins. Do not use "*" with NODE_ENV=production.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# S3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false
MEDIA_BASE_URL=

# EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@poloconnect.app
RESEND_API_KEY=

# OAUTH
APPLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=

# MERCADO PAGO (marketplace publication fee)
# MP_ACCESS_TOKEN and MP_WEBHOOK_SECRET are secrets: backend/Railway only, never expose to the client.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLICATION_PRICE_ARS=


# Demo seeds are blocked in production unless this is intentionally set.
ALLOW_PRODUCTION_DEMO_SEED=false
