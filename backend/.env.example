NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
PUBLIC_BASE_URL=http://localhost:4000
# Production example:
# PUBLIC_BASE_URL=https://your-public-backend.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Local Docker example:
# DATABASE_URL=postgresql://poloconnect:poloconnect@localhost:5432/poloconnect?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000
# Production example:
# CORS_ORIGIN=https://your-frontend.example.com,https://your-expo-tunnel.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@poloconnect.app
APPLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_ID=
S3_ENDPOINT=
S3_BUCKET=poloconnect-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Leave MEDIA_BASE_URL unset to serve media through the backend's own S3 proxy (/media/*).
# CloudFront is on standby for a future iteration; when ready, set MEDIA_BASE_URL to the
# distribution domain (e.g. https://dxxxxxxxxxxxx.cloudfront.net) to serve assets via CDN instead.
MEDIA_BASE_URL=
MP_PUBLICATION_PAYMENT_URL=
