# Local development from the same machine:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Keep web blocked by default. Enable only for local developer usage.
EXPO_PUBLIC_ENABLE_WEB_DEV=false
# Expo Go from other networks:
# EXPO_PUBLIC_API_URL=https://your-public-backend.example.com/api/v1
# Production / Railway:
# EXPO_PUBLIC_API_URL=https://poloconnect-production.up.railway.app/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
