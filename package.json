    "frontend:android": "npm --prefix frontend run android",
    "frontend:ios": "npm --prefix frontend run ios",
    "frontend:web": "npm --prefix frontend run web",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
